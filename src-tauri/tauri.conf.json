{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "포켓몬키우기",
  "mainBinaryName": "poketmon-idle",
  "version": "../package.json",
  "identifier": "com.poketmonidle.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2ODE3MDIzRjNBNDkwOUEKUldTYWtLVHpJM0NCcHZMbGx4SzNzS0I0NlUzOXE0NFBhUUJUSHJ1NVI2TVhiejczNXBud3d4c1oK",
      "endpoints": [
        "https://github.com/ESeungJun/poketmon_idle/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
